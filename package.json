{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "shoelace:copy-assets": "mkdir -p src/shoelace-assets && cp -r node_modules/@shoelace-style/shoelace/dist/assets src/shoelace-assets",
    "esbuild": "npm run shoelace:copy-assets && node esbuild.config.js --minify",
    "esbuild-dev": "npm run shoelace:copy-assets && node esbuild.config.js --watch"
  },
  "devDependencies": {
    "@ruby2js/esbuild-plugin": "^0.0.3",
    "cssnano": "^5.1.14",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.12",
    "postcss-color-mod-function": "^3.0.3",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^14.1.0",
    "postcss-load-config": "^6.0.1",
    "postcss-mixins": "^9.0.4",
    "postcss-preset-env": "^7.4.3",
    "read-cache": "^1.0.2"
  },
  "dependencies": {
    "@hotwired/turbo": "^7.2.4",
    "@shoelace-style/shoelace": "^2.0.0-beta.88",
    "bridgetown-lit-renderer": "3.0.0",
    "esbuild-plugin-lit-css": "^4.1.2",
    "lit": "^3.3.3"
  }
}
